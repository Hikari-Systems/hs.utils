{
  "name": "@hikari-systems/hs.utils",
  "version": "0.0.67",
  "description": "General tools for use in Hikari Systems apps",
  "main": "es2021/index.js",
  "author": "Rick Knowles <rick.knowles@hikari-systems.com>",
  "license": {
    "type": "Apache-2.0",
    "url": "https://opensource.org/licenses/apache2.0.php"
  },
  "scripts": {
    "prepare": "npm run lint && npm run checkTypes && npm run build",
    "test": "jest",
    "lint": "eslint ./lib",
    "checkTypes": "tsc --noEmit",
    "build": "rm -rf ./es2021 && tsc --declaration && npm run copy-dts",
    "test-ci": "npm run prepare && npm test",
    "format": "npx prettier --write --ignore-unknown \"**/*.*[t|j]s\"",
    "copy-dts": "cp ./lib/*.d.ts es2021 && touch es2021/types.js"
  },
  "dependencies": {
    "@langchain/aws": "^0.1.4",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.49",
    "@langchain/langgraph-checkpoint": "^0.0.15",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.4",
    "@langchain/openai": "^0.4.4",
    "connect-pg-simple": "^10.0.0",
    "connect-redis": "^7.1.1",
    "dayjs": "^1.11.11",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "handlebars": "^4.7.8",
    "jose": "^5.10.0",
    "nconf": "^0.12.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.13.3",
    "ioredis": "^5.4.2",
    "resend": "^6.9.2",
    "together-ai": "^0.13.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@types/express": "^4.17.0",
    "@types/express-serve-static-core": "^4.19.0",
    "@types/express-session": "^1.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.12",
    "@types/nconf": "^0.10.6",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^17.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "sinon": "^21.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.8.3"
  },
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hikari-Systems/hs-utils.git"
  },
  "overrides": {
    "langsmith": ">=0.4.6",
    "fast-xml-parser": ">=5.3.6"
  },
  "keywords": [
    "hikari",
    "utilities"
  ],
  "types": "./es2021/index.d.ts",
  "bugs": {
    "url": "https://github.com/Hikari-Systems/hs-utils/issues"
  },
  "homepage": "https://github.com/Hikari-Systems/hs-utils#readme"
}
